{
  "name": "cortad",
  "version": "0.2.1",
  "description": "Connects the AI app on your machine to Cortad for test conversations, and gives your coding agent the MCP and skill to run them. No dependencies.",
  "bin": {
    "cortad": "local.mjs"
  },
  "type": "module",
  "files": [
    "README.md",
    "lib/cli.mjs",
    "lib/home.mjs",
    "lib/identities.mjs",
    "lib/keys.mjs",
    "lib/listing.mjs",
    "lib/lock.mjs",
    "lib/mcp.mjs",
    "lib/mint.mjs",
    "lib/pyhook/sitecustomize.py",
    "lib/register.mjs",
    "lib/replay.mjs",
    "lib/sample.mjs",
    "lib/service.mjs",
    "lib/start.mjs",
    "lib/switches.mjs",
    "lib/trace.cjs",
    "lib/verbs.mjs",
    "local.mjs",
    "skill/SKILL.md",
    "skill/references/results.md"
  ],
  "scripts": {
    "test": "node --test lib/*.test.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "homepage": "https://cortad.com",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brainsless/cortad.git"
  },
  "bugs": {
    "url": "https://github.com/brainsless/cortad/issues"
  }
}
