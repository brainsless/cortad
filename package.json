{
  "name": "cortad",
  "version": "0.1.1",
  "description": "Runs Cortad test conversations against the app on your machine. Env values never leave it. Zero dependencies, no install scripts.",
  "bin": {
    "cortad": "local.mjs"
  },
  "type": "module",
  "files": [
    "local.mjs",
    "lib/door.mjs",
    "lib/lock.mjs",
    "README.md",
    "lib/identities.mjs",
    "lib/mint.mjs",
    "lib/trace.cjs",
    "lib/replay.mjs",
    "lib/start.mjs",
    "lib/pyhook/sitecustomize.py"
  ],
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "homepage": "https://cortad.com",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brainsless/cortad.git"
  },
  "bugs": {
    "url": "https://github.com/brainsless/cortad/issues"
  }
}
