{
  "name": "cortad",
  "version": "0.3.1-rc.12",
  "description": "Connects the AI app on your machine to Cortad for test conversations, and gives your coding agent the MCP and skill to run them. No dependencies.",
  "bin": {
    "cortad": "local.mjs"
  },
  "type": "module",
  "files": [
    "README.md",
    "lib/backing.mjs",
    "lib/cli.mjs",
    "lib/contact-text.mjs",
    "lib/data.mjs",
    "lib/failed-text.mjs",
    "lib/fresh.mjs",
    "lib/health.mjs",
    "lib/held.mjs",
    "lib/home.mjs",
    "lib/hosted.mjs",
    "lib/env-secrets.mjs",
    "lib/identities.mjs",
    "lib/keeping.mjs",
    "lib/keys.mjs",
    "lib/ledger.mjs",
    "lib/listing.mjs",
    "lib/lock.mjs",
    "lib/mcp.mjs",
    "lib/mint.mjs",
    "lib/mongo.mjs",
    "lib/numbers-text.mjs",
    "lib/pg.mjs",
    "lib/proc.mjs",
    "lib/proof.mjs",
    "lib/qdrant.mjs",
    "lib/pyhook/sitecustomize.py",
    "lib/pyhook/cortad_tied.py",
    "lib/pyhook/cortad_sites.py",
    "lib/read-text.mjs",
    "lib/redis.mjs",
    "lib/register.mjs",
    "lib/replay.mjs",
    "lib/runner.mjs",
    "lib/sample.mjs",
    "lib/service.mjs",
    "lib/spec.mjs",
    "lib/start.mjs",
    "lib/stick.mjs",
    "lib/stores.mjs",
    "lib/switches.mjs",
    "lib/tether.mjs",
    "lib/text.mjs",
    "lib/tied.cjs",
    "lib/trace.cjs",
    "lib/verbs.mjs",
    "lib/writes.mjs",
    "lib/words.mjs",
    "local.mjs",
    "skill/SKILL.md",
    "skill/references/results.md"
  ],
  "scripts": {
    "test": "node --test lib/*.test.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "homepage": "https://cortad.com",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brainsless/cortad.git"
  },
  "bugs": {
    "url": "https://github.com/brainsless/cortad/issues"
  }
}
